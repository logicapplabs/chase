# Copy to .env.local and fill in.

# Browser app. The anon key is meant to ship in the client.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=

# Scheduler only. Never expose the service role key in the browser.
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=

# Keys: npm run keys
#
# 1. Apply supabase/migrations/20261012120000_init.sql
# 2. Deploy send-nudges with JWT verification turned off
# 3. Set SUPABASE_SERVICE_ROLE_KEY, VAPID_*, and CRON_SECRET on that function
# 4. Schedule it every 5 minutes with header x-cron-secret: $CRON_SECRET
#
# On this PC, the same job is: npm run nudge
